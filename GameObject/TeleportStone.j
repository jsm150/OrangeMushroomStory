library TeleportStone initializer init needs Water
    globals
        public region Region

        private rect array CompareRect
        private integer array ExitNumber
        private string array Color
    endglobals
    
    public function Main takes integer i returns boolean
        local integer j = 1
        local real now_x = GetUnitX(OrangeMushroom[i])
        local real now_y = GetUnitY(OrangeMushroom[i])
        local real x
        local real y
        local rect r
        
        loop
        exitwhen CompareRect[j] == null
            if RectContainsUnit(CompareRect[j], OrangeMushroom[i]) == true then

                 if CompareRect[j] == gg_rct_CaveEntrance and CaveHiddenEvent_CaveEntranceOpen == false then
                    return false
                 endif

                if MushroomMoving_RectCondition(i, now_x, now_y, 40,"DownWidth") == false and gravity[i] <= 0 then
                    set x = GetRectCenterX(CompareRect[ExitNumber[j]])
                    set y = GetRectCenterY(CompareRect[ExitNumber[j]])
                    loop
                        set r = Rect(x-64, y-64, x+64, y+64)
                        exitwhen CountUnitsInGroup(GetUnitsInRectAll(r)) == 0
                        if GravityChanger_State == false then
                            set y = y + 32
                        else
                            set y = y - 32
                        endif
                        call RemoveRect(r)
                    endloop
                    call RemoveRect(r)
                    
                    set Frame_MainPlayerY = 0
                    call MushroomMoving_RectCondition(i, now_x, now_y, 40, "DownWidthOM")
                    if Frame_MainPlayerY != 0 and MushroomType(GetUnitTypeId(OrangeMushroom[Frame_MainPlayerY])) == false then
                        if GravityChanger_State == false then
                            set y = y + 90
                        else
                            set y = y - 90
                        endif
                    endif
                
                    if GetTerrainType(x, y) == BACKGROUND_TILE and ((GravityChanger_State == false and GetTerrainType(x, y+40) == BACKGROUND_TILE) or (GravityChanger_State == true and GetTerrainType(x, y-40) == BACKGROUND_TILE)) then
                        call DestroyEffect(AddSpecialEffect( "war3mapImported\\Teleport.mdl", now_x, now_y ))
                        call DestroyEffect(AddSpecialEffect( "war3mapImported\\Teleport.mdl", x, y ))
                        if Color[j] == "Red" and GetLocalPlayer() == Player(i-1) then
                            call CinematicFilterGenericBJ( 0.50, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\DreamFilter_Mask.blp", 100, 0.00, 0.00, 50.00, 100.00, 0, 0, 100.00 )
                        elseif Color[j] == "Blue" and GetLocalPlayer() == Player(i-1) then
                            call CinematicFilterGenericBJ( 0.50, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\DreamFilter_Mask.blp", 0, 0.00, 100.00, 50.00, 0.00, 0, 100, 100.00 )
                        elseif Color[j] == "Yellow" and GetLocalPlayer() == Player(i-1) then
                            call CinematicFilterGenericBJ( 0.50, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\DreamFilter_Mask.blp", 100, 100.00, 0.00, 50.00, 100.00, 100, 0, 100.00 )
                        endif
                        call Water_EffectTimer(i)
                        call SetUnitPosition( OrangeMushroom[i], x, y )
                        if Frame_MainPlayerY != 0 and MushroomType(GetUnitTypeId(OrangeMushroom[Frame_MainPlayerY])) == false and Frame_MainPlayerY > PLAYER_MAXINUM then
                            call DestroyEffect(AddSpecialEffect( "war3mapImported\\Teleport.mdl", GetUnitX(OrangeMushroom[Frame_MainPlayerY]), GetUnitY(OrangeMushroom[Frame_MainPlayerY]) ))
                            call Water_EffectTimer(Frame_MainPlayerY)
                            if GravityChanger_State == false then
                                call SetUnitPosition( OrangeMushroom[Frame_MainPlayerY], x, y-90 )
                                call DestroyEffect(AddSpecialEffect( "war3mapImported\\Teleport.mdl", x, y-90 ))
                            else
                                call SetUnitPosition( OrangeMushroom[Frame_MainPlayerY], x, y+90 )
                                call DestroyEffect(AddSpecialEffect( "war3mapImported\\Teleport.mdl", x, y+90 ))
                            endif
                        endif
                        if (j >= 232 and j <= 245) or j == 264 or j == 265 then
                            call SetUnitPosition( BackGroundUnits[i], GetRectMinX(CompareRect[ExitNumber[j]]), GetRectCenterY(CompareRect[ExitNumber[j]]) )
                        else
                            call BackGroundMove(i, now_x, now_y)
                        endif
                    else
                        call DisplayTimedTextToPlayer(Player(i-1), 0, 0, 5, "※ 출구에 빈 공간이 없어 이동할 수 없습니다!")
                    endif
                    set r = null
                    return true
                else
                    call DisplayTimedTextToPlayer(Player(i-1), 0, 0, 5, "※ 땅 또는 오브젝트(버섯, 상자, 문어 블럭)위에 올라탄 상태에서만 이용할 수 있습니다.")
                    call DisplayTimedTextToPlayer(Player(i-1), 0, 0, 5, "※ 상자, 문어 블럭 등을 밟고 이동하면 같이 이동됩니다.")
                endif
            endif
        set j = j + 1
        endloop
        
        set r = null
        return false
    endfunction
    
    private function SetRect takes rect r, integer i, integer exit, string s returns nothing
        call RegionAddRect( Region, r )
        set CompareRect[i] = r
        set ExitNumber[i] = exit
        set Color[i] = s
    endfunction
    
    
